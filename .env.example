# ==============================================================================
# Конфигурация сервиса «Прозрачная вакансия» (КАНТКОД)
# Скопируйте этот файл в .env при необходимости переопределения параметров.
# Сервис работает «из коробки» даже без файла .env!
# ==============================================================================

# --- Источник данных API «Работа в России» (Регион 39 — Калининградская обл.) ---
API_URL=http://opendata.trudvsem.ru/api/v1/vacancies/region/39
API_TIMEOUT_SECONDS=15

# Максимальное число вакансий за один прогон и размер страницы (пагинация >= 2 страниц)
MAX_VACANCIES=20
PAGE_LIMIT=10

# --- Расписание автоматического запуска (в минутах или cron-выражение) ---
SCHEDULE_INTERVAL_MINUTES=60
SCHEDULE_CRON=0 * * * *

# --- Пути к файлам отчётов ---
SAMPLE_INPUT_PATH=kantkod_sample_vacancies.json
REPORT_OUTPUT_PATH=reports/latest_report.json
SAMPLE_REPORT_OUTPUT_PATH=reports/sample_report.json
LAST_SUCCESSFUL_REPORT_PATH=reports/last_successful_report.json

# --- Настройки ИИ-модуля ---
# Доступные значения AI_PROVIDER:
#   auto        - автоматически использует облачный API (если есть ключ), иначе Ollama (если запущена), иначе встроенную локальную ИИ-модель (без аккаунта и ключей)
#   ollama      - локальная LLM через Ollama (бесплатно, без покупки аккаунта)
#   openrouter  - OpenRouter API (поддерживает бесплатные модели с суффиксом :free)
#   gemini      - Google Gemini API
#   openai      - OpenAI или любой OpenAI-совместимый сервер (vLLM, LM Studio, Jan)
#   local_ai    - встроенный локальный семантический ИИ-модуль (работает автономно на CPU без внешних сервисов)
AI_PROVIDER=auto

# Настройки для локального запуска через Ollama (не требует ключей и аккаунта)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Настройки для OpenRouter (можно использовать бесплатные модели, например google/gemma-3-27b-it:free)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it:free

# Настройки для Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Настройки для OpenAI / OpenAI-совместимого API (LM Studio, vLLM и др.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Веб-интерфейс ---
WEB_HOST=127.0.0.1
WEB_PORT=8085
